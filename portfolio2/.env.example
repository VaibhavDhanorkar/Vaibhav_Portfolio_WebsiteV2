# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Sanity (create a project at https://sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your_read_token

# Optional: instant revalidation when publishing in Studio
SANITY_REVALIDATE_SECRET=your_random_secret

# Seed script only (write token from sanity.io/manage → API → Tokens)
SANITY_API_WRITE_TOKEN=your_write_token

# Local dev port (package.json defaults to 3001)
PORT=3001

# Comma-separated public/ files that must exist at build time (optional)
# REQUIRED_ASSETS=resume.pdf
